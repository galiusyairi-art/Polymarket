# Copy this file to polybot.env (same folder as start.bat) and fill in your values.
# polybot.env stays only on this computer: it is never uploaded to GitHub (see .gitignore).
# Never send it, or the key in it, to anyone.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
# Optional: email notices (the same values as on Render)
SMTP_USER=
SMTP_PASSWORD=
